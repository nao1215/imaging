# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
cover.*

# Shrunk failing inputs written by rapid; the Property workflow uploads them.
testdata/rapid/

# Bytecode Python leaves beside scripts/lock_actions.py when it runs.
__pycache__/
